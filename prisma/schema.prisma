// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---- Sale Calendar: scheduled products in one merchant-chosen collection ----

model DiscountSettings {
  shop          String    @id
  compareAtRule String    @default("any")
  syncedRule    String?
  lastSyncAt    DateTime?
  lastSyncError String?
}

model DiscountCollectionMirror {
  shop                 String
  originalCollectionId String
  protectedCollectionId String
  @@id([shop, originalCollectionId])
  @@unique([shop, protectedCollectionId])
}

model SaleSettings {
  shop            String    @id
  collectionId    String?
  collectionTitle String?
  // The app's own source inside the chosen collection (null when no sale is live).
  sourceId        String?
  timezone        String    @default("UTC")
  reorder         Boolean   @default(true)
  needsReorder    Boolean   @default(false)
  lastSyncAt      DateTime?
  lastSyncMessage String?
}

model Sale {
  id        Int           @id @default(autoincrement())
  shop      String
  name      String
  startsAt  DateTime?
  endsAt    DateTime?
  position  Int
  sheetTab  String?
  // JSON array of sheet product names that did not match a store product.
  unmatched String        @default("[]")
  createdAt DateTime      @default(now())
  products  SaleProduct[]

  @@index([shop])
}

model SaleProduct {
  id        Int    @id @default(autoincrement())
  saleId    Int
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  title     String
  position  Int

  @@index([saleId])
}

model SaleSyncLog {
  id      Int      @id @default(autoincrement())
  shop    String
  at      DateTime @default(now())
  message String

  @@index([shop, at])
}
